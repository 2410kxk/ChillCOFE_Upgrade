@{ ViewData["Title"] = "Dashboard thống kê"; }
<section class="lx-dashboard ux-page"><div class="ux-page-head"><div><p class="lx-kicker">CHILL COFÉ / QUẢN TRỊ</p><h1>Góc nhìn kinh doanh.</h1><p>Doanh thu từ đơn đã thanh toán, lọc theo thời điểm thu tiền (đơn cũ chưa có mốc thu tiền dùng ngày tạo đơn). Đơn vị: VNĐ.</p></div><a class="lx-button" href="/Pos/Tables">Đến quầy bán hàng </a></div>
<form id="filters"><label>Từ ngày <input type="date" id="from" required></label><label>Đến hết ngày <input type="date" id="to" required></label><button id="load">Xem thống kê</button></form>
<p id="state" role="status"></p><section class="cards"><article>Doanh thu<strong id="revenue">—</strong></article><article>Đơn đã thanh toán<strong id="paid">—</strong></article><article>Tổng số đơn<strong id="total">—</strong></article><article>Đơn đã hủy<strong id="cancelled">—</strong></article></section>
<div class="cc-chart-grid"><article class="ux-panel"><h2>Doanh thu theo ngày</h2><svg id="daily-chart" viewBox="0 0 600 240" role="img" aria-label="Doanh thu theo ngày"></svg><details><summary>Xem số liệu theo ngày</summary><div id="daily-data"></div></details></article><article class="ux-panel"><h2>Cơ cấu đơn hàng</h2><svg id="orders-chart" viewBox="0 0 320 240" role="img" aria-label="Cơ cấu đơn hàng"></svg><div id="orders-legend"></div></article></div><h2 class="ux-block-title">Hương vị được yêu thích</h2><p>Xếp hạng theo tổng số lượng trong các đơn đã thanh toán.</p><div id="bars"></div><div class="ux-panel ux-table-panel"><div class="table-responsive"><table><thead><tr><th>Món</th><th>Số lượng</th><th>Thành tiền trước giảm giá</th></tr></thead><tbody id="rows"></tbody></table></div></div><p id="empty" hidden>Không có dữ liệu trong khoảng ngày này.</p>
</section>
@section Scripts { <script src="~/js/api-dashboard.js" asp-append-version="true"></script> }

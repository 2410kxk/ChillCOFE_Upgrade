@inject QuanLiQuanCaffee.Services.SiteData SiteData
@{ var site=await SiteData.Load();var staff=User.IsInRole("Admin")||User.IsInRole("Staff"); }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#493021"/><title>@ViewData["Title"] · Chill COFÉ</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="~/css/chill.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/chill-luxe.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/chill-interface.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/chill-refinement.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/chill-community.css" asp-append-version="true"/>
<script src="~/lib/jquery/dist/jquery.min.js"></script><link rel="stylesheet" href="~/css/chill-online.css" asp-append-version="true"/></head>
<body class="luxe-site @(ViewData["Workspace"] is true?"ux-workspace":"ux-storefront")"><a class="lx-skip" href="#main">Đến nội dung chính</a>@Html.AntiForgeryToken()
<header class="cc-header" id="site-header"><nav class="cc-left" aria-label="Khám phá"><a href="/">Trang chủ</a><div class="mega-wrap"><button type="button" class="mega-trigger" aria-expanded="false" aria-controls="drink-mega">Thực đơn</button><div class="drink-mega" id="drink-mega"><div class="mega-heading"><strong>Một hương vị dành riêng cho bạn.</strong><a href="/Cafe/Menu">Xem toàn bộ thực đơn</a></div><div class="mega-columns">@foreach(var category in site.Categories){var drinks=site.Products.Where(p=>p.CategoryID==category.CategoryID).ToList();if(drinks.Any()){<section><h2>@category.Name</h2>@foreach(var drink in drinks){<a href="/Product/Details/@drink.ProductID">@drink.Name</a>}</section>}}</div></div></div></nav>
<a class="cc-logo" href="/" aria-label="Chill COFÉ – Trang chủ"><span>Chill</span><small>COFÉ</small></a>
<nav class="cc-right" aria-label="Tài khoản và trải nghiệm">@if(User.Identity?.IsAuthenticated==true&&!staff){<form action="/Cafe/Menu" method="get" class="online-nav-search"><input name="search" type="search" placeholder="Tìm món…" aria-label="Tìm món" maxlength="100"/><button aria-label="Tìm kiếm">⌕</button></form>}<a class="review-nav" href="/Reviews">Đánh Giá & Trải Nghiệm</a>@if(User.Identity?.IsAuthenticated==true&&!staff){<a href="/Online" class="online-nav-cart" aria-label="Giỏ hàng"><span aria-hidden="true">🛒</span> <span data-online-count>0</span></a>}@if(staff){<a href="/Online/Deliveries">Đơn giao hàng</a><a href="@(User.IsInRole("Admin")?"/Admin":"/Pos/Tables")">Không gian làm việc</a>}
@if(User.Identity?.IsAuthenticated==true){<a href="/Notifications" class="bell-link" aria-label="Thông báo: @site.Unread chưa đọc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M9 21h6"/></svg>@if(site.Unread>0){<span class="unread-count">@(site.Unread>99?"99+":site.Unread.ToString())</span>}</a><a class="profile-link" href="/Profile" title="@site.Name">@if(!string.IsNullOrEmpty(site.Avatar)){<img src="@site.Avatar" alt=""/>}<span>@site.Name</span></a><form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button>Đăng xuất</button></form>}else{<a href="/Identity/Account/Login">Đăng nhập</a>}</nav></header>
<div class="ux-app-shell">@if(ViewData["Workspace"] is true){<partial name="_WorkspaceNav"/>}<main id="main" tabindex="-1">@if(TempData["Success"] is string ok){<div class="cc-flash success" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="cc-flash error" role="alert">@error</div>}@RenderBody()</main></div>
<footer class="cc-footer"><div class="cc-footer-grid"><section><a class="cc-logo" href="/"><span>Chill</span><small>COFÉ</small></a><p>Một chút cà phê, một khoảng bình yên.<br>Chăm chút từng hương vị, trân trọng mỗi lần bạn ghé.</p><a href="/Reviews">Chia sẻ trải nghiệm của bạn</a></section><section><h2>Ghé một khoảng chill</h2><strong>@site.Store.StoreName</strong>@if(!string.IsNullOrWhiteSpace(site.Store.Address)){<p>@site.Store.Address</p>}@if(!string.IsNullOrWhiteSpace(site.Store.OpeningHours)){<p>@site.Store.OpeningHours</p>}@if(!string.IsNullOrWhiteSpace(site.Store.Phone)){<a href="tel:@site.Store.Phone">@site.Store.Phone</a>}@if(!string.IsNullOrWhiteSpace(site.Store.Email)){<a href="mailto:@site.Store.Email">@site.Store.Email</a>}</section><section><h2>Hẹn bạn ở Chill COFÉ</h2><p>Tìm món yêu thích và những cập nhật mới từ quán.</p><a class="footer-cta" href="/Cafe/Menu">Khám phá thực đơn</a><a href="/Notifications">Thông báo từ quán</a><a href="/Profile">Tài khoản của bạn</a></section></div><div class="cc-footer-bottom"><span>© @DateTime.Now.Year Chill COFÉ</span><a href="/Home/Privacy">Quyền riêng tư</a></div></footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><script>$.ajaxSetup({beforeSend:function(xhr,settings){var token=document.querySelector('input[name="__RequestVerificationToken"]');if(token&&!settings.crossDomain&&!/^(GET|HEAD|OPTIONS)$/i.test(settings.type)){xhr.setRequestHeader('RequestVerificationToken',token.value);}}});</script>
<script src="~/js/chill.js" asp-append-version="true"></script><script src="~/js/chill-interface.js" asp-append-version="true"></script><script src="~/js/chill-luxe.js" asp-append-version="true"></script><script src="~/js/chill-community.js" asp-append-version="true"></script><div id="online-toast" role="status" aria-live="polite" hidden></div><script src="~/js/chill-online.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
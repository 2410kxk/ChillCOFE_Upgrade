@{
    ViewData["Title"] = "Thanh toán Online";
}

<style>
    .checkout-container {
        max-width: 600px;
        margin: auto;
    }

    .checkout-card {
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .title {
        font-weight: 700;
        color: #6f4e37; /* màu cafe */
    }

    .form-control {
        border-radius: 12px;
        padding: 10px;
        border: 1px solid #ddd;
        transition: 0.2s;
    }

        .form-control:focus {
            border-color: #c69c6d;
            box-shadow: 0 0 0 2px rgba(198,156,109,0.2);
        }

    .btn-order {
        background: linear-gradient(135deg, #6f4e37, #c69c6d);
        border: none;
        border-radius: 30px;
        padding: 12px;
        font-weight: bold;
        color: white;
        transition: 0.3s;
    }

        .btn-order:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .input-icon {
        position: relative;
    }

        .input-icon span {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
        }

        .input-icon input,
        .input-icon textarea {
            padding-left: 35px;
        }
</style>

<div class="container mt-5 checkout-container">
    <h3 class="text-center mb-4 title">🚚 Thông tin giao hàng</h3>

    <div class="card checkout-card p-4">

        <!-- HỌ TÊN -->
        <div class="mb-3 input-icon">
            <span>👤</span>
            <input id="name" class="form-control" placeholder="Họ tên" />
        </div>

        <!-- SĐT -->
        <div class="mb-3 input-icon">
            <span>📞</span>
            <input id="phone" class="form-control" placeholder="Số điện thoại" />
        </div>

        <!-- ĐỊA CHỈ -->
        <div class="mb-3 input-icon">
            <span>📍</span>
            <textarea id="address" class="form-control" rows="3" placeholder="Địa chỉ giao hàng"></textarea>
        </div>

        <!-- BUTTON -->
        <button class="btn btn-order w-100" onclick="submitOrder()">
            🚀 GIAO HÀNG
        </button>
    </div>
</div>

<script>
    function submitOrder() {
        var name = $("#name").val();
        var phone = $("#phone").val();
        var address = $("#address").val();

        if (!name || !phone || !address) {
            Swal.fire({
                icon: 'warning',
                title: 'Thiếu thông tin',
                text: 'Vui lòng nhập đầy đủ thông tin!'
            });
            return;
        }

        // loading đẹp hơn
        Swal.fire({
            title: 'Đang xử lý...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.post('/Order/PlaceOnlineOrder', {
            name: name,
            phone: phone,
            address: address
        }, function (res) {
            if (res.success) {
                Swal.fire('Thành công!', 'Đã đặt hàng!', 'success')
                    .then(() => window.location.href = "/");
            } else {
                Swal.fire('Lỗi!', 'Không thể đặt hàng!', 'error');
            }
        }).fail(function () {
            Swal.fire('Lỗi!', 'Không kết nối được server!', 'error');
        });
    }
</script>
@{ ViewData["Title"] = "Giỏ hàng của bạn"; }
<section class="co-online online-page" data-online-cart>
<header class="co-head"><div><p class="co-kicker">CHILL COFÉ / ĐẶT MÓN ONLINE</p><h1>Một chút chill,<br />giao tận nơi.</h1><p class="co-muted">Chọn vị bạn thích. Phần còn lại, để Chill chăm chút.</p></div><nav class="co-actions" aria-label="Đặt món"><a class="co-btn" href="/Cafe/Menu">← Thêm món</a><a class="co-btn" href="/Online/History">Lịch sử đặt món</a></nav></header>
<div class="co-steps" aria-label="Quy trình đặt hàng"><span class="active">01 · Chọn món</span><span>02 · Thông tin giao hàng</span><span>03 · Chờ xác nhận</span></div>
<div class="online-layout"><div><h2>Giỏ hàng của bạn</h2><p class="co-muted">Kiểm tra size, topping và ghi chú trước khi đặt nhé.</p><div id="online-lines" aria-live="polite"><div class="co-panel">Đang tải giỏ hàng…</div></div><p class="co-note">Một món đúng gu làm ngày thường dễ chịu hơn một chút.</p></div>
<aside class="surface online-summary"><p class="co-kicker">MỘT ĐƠN NHỎ, MỘT NIỀM VUI</p><h2>Tóm tắt đơn hàng</h2><p>Tạm tính <strong id="online-subtotal">—</strong></p><p>Phí giao hàng <strong>0 đ</strong></p><hr /><p>Tổng thanh toán <strong id="online-total" class="co-price">—</strong></p><button type="button" class="lx-button" id="online-checkout-open" disabled>Tiến hành đặt hàng →</button><small>Quán sẽ xác nhận đơn trước khi giao. Chọn phương thức thanh toán chưa có nghĩa là đã thanh toán.</small></aside></div>
<div class="co-mobile-checkout"><div><small>Tổng thanh toán</small><strong data-co-mobile-total>—</strong></div><button type="button" class="co-primary" data-co-mobile-open disabled>Đặt hàng →</button></div>
<dialog id="online-checkout" class="online-dialog" aria-labelledby="co-shipping-title"><form id="online-shipping"><button type="button" data-online-close class="quiet-button co-close" aria-label="Đóng thông tin giao hàng">Đóng ✕</button><div><p class="co-kicker">CHỈ CÒN MỘT BƯỚC</p><h2 id="co-shipping-title">Gửi chút chill đến bạn</h2><p class="co-muted">Điền thông tin để quán liên hệ và giao đúng địa chỉ.</p></div>
<label>Họ và tên<input name="name" required maxlength="100" autocomplete="name" placeholder="Tên người nhận" /></label>
<label>Số điện thoại<input name="phone" required pattern="\+?[0-9]{9,15}" maxlength="16" type="tel" autocomplete="tel" placeholder="Ví dụ: 0901234567" /></label>
<label>Địa chỉ giao hàng<textarea name="address" required minlength="5" maxlength="300" autocomplete="street-address" placeholder="Số nhà, đường, phường/xã và tỉnh/thành phố"></textarea></label>
<label>Phương thức thanh toán<select name="paymentMethod"><option>Tiền mặt</option><option>Chuyển khoản</option></select></label><p class="co-note">Trả tiền mặt khi nhận hàng hoặc chuyển khoản theo hướng dẫn của nhân viên.</p><p id="online-checkout-error" role="alert"></p><button type="submit" class="lx-button">Xác nhận đặt hàng</button></form></dialog>
</section>

<style>
.co-online{--ink:#402d25;--muted:#78675d;--line:rgba(102,72,48,.17);--accent:#754932;color:var(--ink);max-width:1200px;margin:32px auto 70px;padding:32px;border-radius:28px;background:linear-gradient(135deg,rgba(252,247,238,.96),rgba(240,228,210,.92));box-shadow:0 20px 70px #33241612;font-family:inherit;line-height:1.6}
.co-online *{box-sizing:border-box}.co-online [hidden]{display:none!important}.co-online h1{font-family:Georgia,serif;font-size:clamp(30px,4vw,48px);line-height:1.15;letter-spacing:-1.2px;margin:8px 0 16px;color:var(--ink)}.co-online h2{font-size:20px;margin:0 0 14px;color:var(--ink)}.co-online p{margin:8px 0}.co-online .co-kicker{font-size:11px;letter-spacing:2.4px;font-weight:750;color:var(--accent)}.co-online .co-muted,.co-online small{color:var(--muted)}.co-head{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:28px}.co-head>div{max-width:740px}.co-online a{color:var(--accent)}.co-online .co-btn,.co-online .lx-button,.co-online button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.55);color:var(--ink);font:inherit;font-size:14px;font-weight:650;cursor:pointer;text-decoration:none;transition:background .2s,transform .2s}.co-online .co-primary,.co-online .lx-button{background:var(--accent);color:#fff8ed;border-color:var(--accent)}.co-online button:hover,.co-online .co-btn:hover{filter:brightness(.96)}.co-online button:disabled{opacity:.5;cursor:not-allowed}.co-online :focus-visible{outline:3px solid #bc8956;outline-offset:3px}.co-online .co-danger{color:#9c3c31;background:#fff2ee}.co-online .co-panel,.co-online .surface{background:rgba(255,253,248,.8);border:1px solid var(--line);border-radius:20px;padding:24px;box-shadow:0 6px 24px #5b3a2010;backdrop-filter:blur(14px)}.co-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.co-online input:not([type=checkbox]):not([type=hidden]),.co-online select,.co-online textarea{width:100%;min-height:46px;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:#fffdf8;color:var(--ink);font:inherit}.co-online textarea{resize:vertical;min-height:90px}.co-online label{display:block;font-size:14px;font-weight:600}.co-online input[type=checkbox]{width:18px;height:18px;accent-color:var(--accent);vertical-align:middle}.co-online .co-toolbar{display:grid;grid-template-columns:minmax(200px,1fr) auto;gap:16px;margin:22px 0 16px}.co-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.co-online .co-tabs button[aria-pressed=true],.co-online .co-metric[aria-pressed=true]{background:var(--accent);color:#fff8ed}.co-list{display:grid;gap:16px}.co-order-top{display:flex;justify-content:space-between;gap:18px;align-items:start}.co-order-id{font-size:19px;font-weight:750}.co-price{font-size:21px;font-weight:750;white-space:nowrap}.co-badges{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.co-badge{display:inline-block;font-size:12px;font-weight:650;padding:5px 10px;border-radius:99px;background:#eee4d5;color:#684b31}.co-badge[data-tone=done],.co-paid{background:#e4efe4;color:#355d3b}.co-badge[data-tone=shipping]{background:#e6edf4;color:#35546e}.co-badge[data-tone=cancelled]{background:#f4e5e1;color:#8c4438}.co-online details{border-top:1px solid var(--line);margin-top:18px;padding-top:14px}.co-online summary{cursor:pointer;font-weight:650;padding:6px 0;color:var(--accent)}.co-detail{padding-top:16px;overflow-wrap:anywhere}.co-detail table{max-width:100%;width:100%}.co-detail-wrap{overflow:auto}.co-customer{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:14px 0 20px}.co-online .co-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}.co-online .co-metric{display:block;text-align:left;padding:18px 22px;border-radius:16px;background:#fffaf2}.co-metric strong{display:block;font-size:30px;margin-top:4px}.co-empty{text-align:center;padding:42px 20px!important}.co-empty h2{font-family:Georgia,serif;font-size:27px}.co-order-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin-top:20px;padding-top:18px;border-top:1px solid var(--line)}.co-order-actions form{margin:0}.co-order-actions label{margin-bottom:10px}.co-online dialog{color:var(--ink);background:#fcf7ef;border:1px solid var(--line);border-radius:22px;width:min(540px,calc(100% - 28px));max-height:90dvh;padding:26px;box-shadow:0 25px 90px #20170d55}.co-online dialog::backdrop{background:#201b1766;backdrop-filter:blur(5px)}.co-online dialog form{display:grid;gap:15px}.co-online dialog .co-close{justify-self:end}.co-online .online-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:24px;align-items:start}.co-online .online-summary{position:sticky;top:100px}.co-online .online-summary p{display:flex;justify-content:space-between;gap:12px;margin:16px 0}.co-online .online-summary button{width:100%}.co-online .online-summary small{display:block;margin-top:14px}.co-online #online-lines{min-width:0;display:grid;gap:16px}.co-online #online-lines>article,.co-online #online-lines>.online-line{background:#fffaf3;border:1px solid var(--line);border-radius:18px;padding:20px}.co-online #online-lines img{width:84px;height:84px;object-fit:cover;border-radius:14px}.co-online #online-lines button{min-width:44px}.co-online #online-lines label{margin:8px 0}.co-online hr{border:0;border-top:1px solid var(--line)}.co-steps{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0;color:var(--muted);font-size:13px}.co-steps span{padding:7px 12px;border-radius:99px;background:#efe4d4}.co-steps .active{background:#754932;color:white}.co-mobile-checkout{display:none}.co-online .co-note{font-size:13px;padding:12px 14px;border-left:3px solid #bc8956;background:#f2e7d6;border-radius:0 8px 8px 0}.co-online .co-live{font-size:13px;color:var(--muted);margin-bottom:14px}.co-online .co-wait{font-size:12px;color:#94602c}.co-online .co-field-error{color:#a2372b;font-size:12px;margin-top:4px}.co-online [aria-invalid=true]{border-color:#a2372b!important}.co-order{animation:co-arrive .35s ease both}@@keyframes co-arrive{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@@media(max-width:850px){.co-online{padding:22px;margin:20px 12px 80px}.co-head{align-items:start;flex-direction:column}.co-online .online-layout{grid-template-columns:1fr}.co-online .online-summary{position:static}.co-online .co-toolbar{grid-template-columns:1fr}.co-online .co-metrics{gap:8px}.co-online .co-metric{padding:12px;font-size:12px}.co-metric strong{font-size:24px}.co-mobile-checkout{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:1000;background:#fcf7eff5;border-top:1px solid var(--line);padding:12px 18px max(12px,env(safe-area-inset-bottom));justify-content:space-between;align-items:center;gap:14px;backdrop-filter:blur(16px)}.co-mobile-checkout strong{display:block}.co-customer{grid-template-columns:1fr}.co-online .co-panel,.co-online .surface{padding:18px}}@@media(max-width:430px){.co-order-top{flex-direction:column;gap:6px}.co-online{padding:18px}.co-tabs button{font-size:12px!important;padding:8px 10px!important}}@@media(prefers-reduced-motion:reduce){.co-online *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
<script>
(()=>{const root=document.querySelector('[data-online-cart]');if(!root)return;const total=root.querySelector('#online-total'),open=root.querySelector('#online-checkout-open'),mobile=root.querySelector('[data-co-mobile-open]');const sync=()=>{root.querySelector('[data-co-mobile-total]').textContent=total.textContent;mobile.disabled=open.disabled};new MutationObserver(sync).observe(total,{childList:true,subtree:true,characterData:true});new MutationObserver(sync).observe(open,{attributes:true,attributeFilter:['disabled']});mobile.addEventListener('click',()=>open.click());sync();const form=root.querySelector('#online-shipping');form.querySelectorAll('input,textarea,select').forEach((field,i)=>{const error=document.createElement('span');error.className='co-field-error';error.id='co-field-error-'+i;error.setAttribute('aria-live','polite');field.after(error);field.setAttribute('aria-describedby',error.id);const validate=()=>{field.setAttribute('aria-invalid',String(!field.validity.valid));error.textContent=field.validity.valid?'':field.validity.valueMissing?'Vui lòng điền thông tin này.':field.name==='phone'?'Nhập 9–15 chữ số, có thể bắt đầu bằng dấu +.':'Vui lòng kiểm tra lại thông tin.'};field.addEventListener('blur',validate);field.addEventListener('invalid',validate);field.addEventListener('input',()=>{if(field.getAttribute('aria-invalid')==='true')validate()})});})();
</script>
@model IEnumerable<Product>
@{ ViewData["Title"] = "Thực đơn trong ngày"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">CHILL COFÉ / MENU</p><h1>Thực đơn trong ngày</h1><p class="ux-subtitle">Những hương vị dành cho khoảng nghỉ của bạn.</p></div><div class="ux-head-actions">@if(User.IsInRole("Admin")){<a href="/Product/Create" class="lx-button">+ Thêm món</a>}</div></header><div id="msg-area" role="status" aria-live="polite"></div>@if(ViewBag.Search != null){<p class="ux-help">Kết quả tìm: @ViewBag.Search</p>}@if(ViewBag.CategoryName != null){<p class="lx-kicker">@ViewBag.CategoryName</p>}<div class="ux-shop-grid">@foreach(var item in Model){<article class="ux-shop-card"><a href="/Product/Details/@item.ProductID"><img src="@item.ImageUrl" alt="@item.Name" loading="lazy"/></a><div><p class="lx-kicker">@item.Category?.Name</p><h2>@item.Name</h2><div class="ux-shop-bottom"><strong>@item.Price.ToString("N0") đ</strong><button class="btn btn-success btn-add" data-id="@item.ProductID">+ Thêm món</button></div>@if(User.IsInRole("Admin")){<div class="ux-form-actions"><a asp-action="Edit" asp-route-id="@item.ProductID">Sửa món</a><a asp-action="Delete" asp-route-id="@item.ProductID">Xóa món</a></div>}</div></article>}</div></section>
@section Scripts {
    <script>
        $(document).ready(function () {

            $(".btn-add").click(function () {

                var btn = $(this);
                var productId = btn.data("id");

                $.ajax({
                    url: '/Order/AddToCart',
                    type: 'POST',
                    data: { id: productId },

                    success: function () {

                        // ❌ Xóa thông báo cũ
                        $("#msg-area").html("");

                        // ✅ Hiện thông báo mới
                        $("#msg-area").show().html(
                            "<div class='alert alert-success text-center'>Đã thêm món!</div>"
                        );

                        // ⏳ Tự ẩn sau 2 giây
                        setTimeout(function () {
                            $("#msg-area").fadeOut();
                        }, 2000);

                        // 🔥 đổi nút
                        btn.text("✔ Đã thêm");
                        btn.removeClass("btn-success").addClass("btn-secondary");

                    },

                    error: function () {
                        alert("Lỗi!");
                    }
                });

            });

        });
    </script>
}
@model QuanLiQuanCaffee.Models.Employee

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> XÁC NHẬN XÓA</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-center fs-5">Bạn có chắc chắn muốn xóa nhân viên này khỏi hệ thống?</p>

                    <div class="alert alert-light border">
                        <div class="row mb-2">
                            <div class="col-5 fw-bold text-muted">Họ và Tên:</div>
                            <div class="col-7 fw-bold text-dark">@Model.FullName</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 fw-bold text-muted">Chức vụ:</div>
                            <div class="col-7">
                                <span class="badge @(Model.Position == "Pha chế" ? "bg-info" : "bg-warning") text-dark">
                                    @Model.Position
                                </span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 fw-bold text-muted">Số điện thoại:</div>
                            <div class="col-7">@Model.Phone</div>
                        </div>
                        <div class="row">
                            <div class="col-5 fw-bold text-muted">Email:</div>
                            <div class="col-7 text-truncate">@Model.Email</div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        @* Form gửi yêu cầu POST đến hàm DeleteConfirmed *@
                        <form asp-action="Delete" method="post">
                            @* Quan trọng: Cần hidden field để truyền ID *@
                            <input type="hidden" asp-for="EmployeeID" name="id" />

                            <button type="submit" class="btn btn-danger px-4 shadow-sm me-2">
                                <i class="bi bi-trash"></i> Xác nhận xóa
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Hủy bỏ
                            </a>
                        </form>
                    </div>
                </div>
                <div class="card-footer bg-light text-center small text-muted py-2">
                    Lưu ý: Hành động này không thể hoàn tác.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .badge {
        font-size: 0.9rem;
    }

    .alert-light {
        background-color: #f8f9fa;
        border-radius: 10px;
    }
</style>
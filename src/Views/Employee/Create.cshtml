@model QuanLiQuanCaffee.Models.Employee

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4>THÊM NHÂN VIÊN MỚI</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label">Họ và Tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vị trí</label>
                        <select asp-for="Position" class="form-select">
                            <option value="Pha chế">Pha chế</option>
                            <option value="Phục vụ">Phục vụ</option>
                            <option value="Quản lý">Quản lý</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lương mỗi giờ (VND)</label>
                        <input asp-for="HourlyRate" class="form-control" type="number" value="27000" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-grow-1">Lưu</button>
                        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
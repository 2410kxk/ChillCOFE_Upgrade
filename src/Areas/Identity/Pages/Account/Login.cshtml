@page
@model QuanLiQuanCaffee.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chào bạn trở lại.";
    Layout = "/Views/Shared/_Layout.cshtml";
    var returnUrl = Model.ReturnUrl ?? Model.Request.Query["returnUrl"].ToString();
}
<link rel="stylesheet" href="~/css/chill-login.css" asp-append-version="true" />
<section class="ux-page cf-login">
    <header class="ux-page-head">
        <div>
            <p class="lx-kicker">CHILL COFÉ / ĐĂNG NHẬP</p>
            <h1>Chào bạn trở lại.</h1>
            <p class="ux-subtitle">Một hương vị quen. Một khoảng chill dành cho bạn.</p>
        </div>
    </header>
    <div class="ux-auth">
        <div class="ux-auth-art">
            <img src="/images/editorial/coffee-art.png" alt="Ly cà phê trong ánh nắng ấm" />
            <p>Một chút cà phê.<br />Một khoảng bình yên.</p>
        </div>
        <form id="login-form" method="post" asp-page="./Login" asp-route-returnUrl="@returnUrl" class="ux-auth-form">
            <p class="lx-kicker">HẸN BẠN Ở MỘT KHOẢNG CHILL</p>
            <h2>Đăng nhập</h2>
            <p class="ux-help">Nhập email và mật khẩu của tài khoản bạn đang sử dụng.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger cf-login-errors" role="alert"></div>
            <div class="ch-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="Email của bạn" required aria-describedby="login-email-error" />
                <span id="login-email-error" asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="ch-field">
                <label asp-for="Input.Password">Mật khẩu</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required aria-describedby="login-password-error" />
                <span id="login-password-error" asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <label class="cf-login-remember" for="Input_RememberMe">
                <input asp-for="Input.RememberMe" />
                <span>Ghi nhớ đăng nhập trên thiết bị này</span>
            </label>
            <button type="submit" class="lx-button cf-login-submit">Đăng nhập</button>
            <p class="ux-help cf-login-register">Chưa có tài khoản? <a href="/Account/Register">Đăng ký</a></p>
            <a class="lx-text-link" href="/">Về trang chủ</a>
        </form>
    </div>
</section>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}

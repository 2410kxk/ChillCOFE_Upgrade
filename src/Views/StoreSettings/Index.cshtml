@model QuanLiQuanCaffee.Models.StoreSetting
@{ViewData["Title"]="Thông tin quán";}
<section class="ux-page narrow"><h1>Thông tin quán</h1><p>Thông tin này được hiển thị tại chân trang.</p><form asp-action="Index" method="post" class="surface form-stack"><div asp-validation-summary="All"></div><label>Tên quán<input asp-for="StoreName" required maxlength="100"/></label><label>Địa chỉ<input asp-for="Address" maxlength="300"/></label><label>Điện thoại<input asp-for="Phone" maxlength="30"/></label><label>Email<input asp-for="Email" type="email" maxlength="150"/></label><label>Giờ mở cửa<input asp-for="OpeningHours" maxlength="150" placeholder="Ví dụ: 07:00 – 22:00 hằng ngày"/></label><button class="lx-button">Lưu thông tin</button></form></section>

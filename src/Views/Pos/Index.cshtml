@model QuanLiQuanCaffee.ViewModels.PosVm
@using System.Text.Json
@{ ViewData["Title"]="Bán hàng · Bàn " + Model.Table.Name; ViewData["Pos"]=true; }
<div class="ch-pos" data-pos data-table="@Model.Table.TableID"><section class="ch-pos-menu" data-catalog><div class="ch-section-head"><div><a class="ch-back" href="/Pos/Tables">← Danh sách bàn</a><h1>Bàn @Model.Table.Name <span class="ch-pill">Tại quán</span></h1></div><span class="ch-eyebrow">CHILL COFÉ / POS</span></div>
<div class="ch-toolbar"><label class="ch-search"><span>⌕</span><input data-search type="search" placeholder="Tìm tên món…" aria-label="Tìm món"/></label><span data-count></span></div>
<div class="ch-tabs"><button class="active" data-filter="all">Tất cả</button>@foreach(var c in Model.Categories){<button data-filter="@c.CategoryID">@c.Name</button>}</div>
<div class="ch-product-grid" data-products>@foreach(var p in Model.Products){<partial name="_ChillProduct" model="p"/>}</div><p data-empty class="ch-empty" hidden>Không tìm thấy món.</p></section>
<aside class="ch-cart"><div class="ch-cart-heading"><div><div class="ch-eyebrow">ĐƠN TẠI BÀN</div><h2>Bàn @Model.Table.Name</h2></div><span class="ch-pill" id="cart-count">0 món</span></div>
<div id="cart-lines" class="ch-cart-lines"><p class="ch-empty">Đang tải đơn hàng…</p></div><div class="ch-cart-summary"><div><span>Tổng cộng</span><strong id="cart-total">0 đ</strong></div><p>Giá đã gồm size và topping đã chọn.</p><button id="checkout-open" class="ch-button" disabled>Thanh toán <span>→</span></button></div></aside></div>
<div id="ch-toast" role="status" aria-live="polite" hidden></div>
<dialog id="pick-dialog" class="ch-dialog"><form id="pick-form"><button type="button" class="ch-close" data-close aria-label="Đóng">×</button><div class="ch-eyebrow">CHILL THEO CÁCH CỦA BẠN</div><h2 id="pick-name"></h2><p id="pick-description"></p>
<div id="custom-fields"><div class="ch-field"><label for="pick-size">Kích cỡ</label><select id="pick-size"><option value="M">M · Giá tiêu chuẩn</option><option value="L">L · +7.000đ</option></select></div>
<div class="ch-field-row"><div class="ch-field"><label for="pick-sugar">Mức đường</label><select id="pick-sugar"><option value="100">100%</option><option value="70">70%</option><option value="50">50%</option><option value="30">30%</option><option value="0">Không đường</option></select></div><div class="ch-field"><label for="pick-ice">Mức đá</label><select id="pick-ice"><option value="100">Bình thường</option><option value="50">Ít đá</option><option value="0">Không đá</option></select></div></div>
<div class="ch-field"><label for="pick-topping">Topping</label><select id="pick-topping"><option value="Không">Không thêm</option><option value="Trân châu">Trân châu · +5.000đ</option><option value="Thạch trái cây">Thạch trái cây · +5.000đ</option><option value="Kem cheese">Kem cheese · +10.000đ</option></select></div></div>
<div class="ch-field-row"><div class="ch-field"><label for="pick-qty">Số lượng</label><input id="pick-qty" type="number" min="1" max="99" value="1" required/></div><div class="ch-field"><label for="pick-note">Ghi chú</label><input id="pick-note" maxlength="200" placeholder="Ví dụ: để riêng topping"/></div></div><p class="ch-inline-error" id="pick-error" role="alert"></p><button class="ch-button" id="pick-submit">Thêm vào đơn <span id="pick-price"></span></button></form></dialog>
<dialog id="pay-dialog" class="ch-dialog"><form id="pay-form"><button type="button" class="ch-close" data-close aria-label="Đóng">×</button><div class="ch-eyebrow">HOÀN TẤT ĐƠN HÀNG</div><h2>Thanh toán</h2><div class="ch-pay-total" id="pay-total"></div><div class="ch-field"><label for="pay-method">Phương thức</label><select id="pay-method"><option>Tiền mặt</option><option>Chuyển khoản</option></select></div><div id="cash-fields"><div class="ch-field"><label for="cash-input">Tiền khách đưa (đ)</label><input id="cash-input" type="number" min="0" max="1000000000" step="1000"/></div><p>Tiền thừa: <strong id="cash-change">0 đ</strong></p></div><p id="transfer-note" hidden>Thu ngân kiểm tra giao dịch đã vào tài khoản trước khi xác nhận. Hệ thống chưa kết nối cổng thanh toán.</p><label class="ch-check"><input id="paid-confirm" type="checkbox" required/> Tôi đã nhận đủ tiền thanh toán.</label><p id="pay-error" class="ch-inline-error" role="alert"></p><button id="pay-submit" class="ch-button">Xác nhận thanh toán →</button></form></dialog>
<script id="pos-products" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Products.Select(p=>new {id=p.ProductID,name=p.Name,price=p.Price,description=p.Description,custom=p.SupportsCustomization})))</script>

@model QuanLiQuanCaffee.Models.Order
@{ViewData["Title"]="Phiếu thanh toán";}
<section class="ch-receipt"><div class="ch-brand">chill<span>COFÉ</span></div><h1>Phiếu thanh toán</h1><p>Đơn #@Model.OrderID · Bàn @Model.Table?.Name<br>Thời điểm tạo đơn: @Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</p><hr/>
@foreach(var d in Model.Details){<div class="ch-receipt-line"><div><strong>@d.Product?.Name × @d.Quantity</strong><p>Size @d.Size · @d.Sugar% đường · @d.Ice% đá · @d.Topping</p>@if(!string.IsNullOrEmpty(d.Note)){<p>Ghi chú: @d.Note</p>}</div><span>@((d.Price*d.Quantity).ToString("N0")) đ</span></div>}
<hr/><div class="ch-receipt-line"><strong>Tổng thanh toán</strong><strong>@Model.TotalAmount.ToString("N0") đ</strong></div><div class="ch-receipt-line"><span>@Model.PaymentMethod</span><span>@Model.CustomerPaid.ToString("N0") đ</span></div><div class="ch-receipt-line"><span>Tiền thừa</span><span>@Model.ChangeAmount.ToString("N0") đ</span></div><p class="ch-receipt-thanks">Cảm ơn bạn đã ghé Chill COFÉ.<br>Hẹn gặp lại trong một ngày thật chill.</p><small>Phiếu nội bộ của bản demo, không phải hóa đơn thuế.</small><div class="ch-actions no-print"><button class="ch-button" onclick="window.print()">In / lưu PDF</button><a class="ch-button secondary" href="/Pos/Tables">Về danh sách bàn</a></div></section>

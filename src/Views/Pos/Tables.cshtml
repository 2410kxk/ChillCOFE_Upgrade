@model IEnumerable<QuanLiQuanCaffee.Models.Table>
@{ ViewData["Title"]="Sơ đồ phòng bàn";
 string Zone(string name){var n=name.Trim().ToUpperInvariant();return System.Text.RegularExpressions.Regex.IsMatch(n,@"^[A-D]\s*\d")?"Khu "+n[0]:"Khu chung";}
 var zones=Model.Select(t=>Zone(t.Name)).Distinct().OrderBy(x=>x).ToList(); }
<section class="ux-page" data-floor><header class="ux-page-head"><div><p class="eyebrow">CHILL COFÉ / KHÔNG GIAN PHỤC VỤ</p><h1>Sơ đồ phòng bàn</h1><p>Cập nhật: @DateTime.Now.ToString("HH:mm") · <a href="/Pos/Tables">Làm mới</a></p></div><div class="floor-toolbar"><button class="active" data-status-filter="all">▦ Tất cả (@Model.Count())</button><button data-status-filter="busy">Đang dùng (@Model.Count(t=>t.Status!="Trống"))</button><button data-status-filter="free">Đang trống (@Model.Count(t=>t.Status=="Trống"))</button></div></header>
<div class="floor-zones"><button class="active" data-zone-filter="all">Tất cả khu</button>@foreach(var zone in zones){<button data-zone-filter="@zone">@zone</button>}</div>
<div class="floor-grid">@foreach(var table in Model){var state=table.Status=="Trống"?"free":"busy";<article class="floor-card" data-table data-zone="@Zone(table.Name)" data-status="@state"><a class="floor-seat @state" href="/Pos/Index?tableId=@table.TableID"><h2>@table.Name</h2><span>@table.Status</span></a>@if(!string.IsNullOrWhiteSpace(table.Note)){<p class="table-note">@table.Note</p>}<details><summary>⋮ Chỉnh chú thích</summary><form asp-controller="Online" asp-action="TableNote" method="post"><input type="hidden" name="id" value="@table.TableID"/><textarea name="note" rows="3" maxlength="300" aria-label="Chú thích @table.Name">@table.Note</textarea><button class="quiet-button">Lưu chú thích</button></form></details></article>}</div><p id="floor-empty" class="empty-state" hidden>Không có bàn phù hợp.</p></section>

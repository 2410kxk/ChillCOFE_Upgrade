@model IEnumerable<QuanLiQuanCaffee.Models.OrderDetail>

@if (Model == null || !Model.Any())
{
    <div class="text-center mt-5">
        <span class="fs-1 text-muted">＋</span>
        <p class="text-muted">Chưa có món nào được chọn</p>
    </div>
}
else
{
    <div class="table-responsive ux-cart-partial" style="max-height: 450px; overflow-y: auto;">
        <table class="table table-borderless align-middle">
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-bottom">
                        <td style="width: 50%">
                            <div class="fw-bold text-truncate" style="max-width: 150px;">@(item.Product?.Name ?? "Sản phẩm")</div>
                            <small class="text-muted">@item.Price.ToString("N0")đ</small>
                        </td>
                        <td style="width: 30%">
                            <div class="d-flex align-items-center justify-content-center border rounded-pill p-1 bg-light">
                                <button class="btn btn-sm p-0 border-0" style="width:25px;" onclick="updateQty(@item.ProductID, -1)">−</button>
                                <span class="mx-2 fw-bold" style="min-width: 20px; text-align: center">@item.Quantity</span>
                                <button class="btn btn-sm p-0 border-0" style="width:25px;" onclick="updateQty(@item.ProductID, 1)">+</button>
                            </div>
                        </td>
                        <td class="text-end fw-bold" style="width: 20%">
                            @((item.Price * item.Quantity).ToString("N0"))đ
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 p-3 bg-light rounded shadow-sm">
        <div class="d-flex justify-content-between mb-3">
            <span class="fw-bold">Tổng cộng:</span>
            <span class="fw-bold text-danger fs-5" id="pos-total">
                @Model.Sum(x => x.Price * x.Quantity).ToString("N0")đ
            </span>
        </div>
        
    </div>

    <script>
        // Hàm này đảm bảo gọi đúng Action UpdateQuantity trong OrderController
        function updateQty(productId, delta) {
            $.post('/Order/UpdateQuantity', { id: productId, delta: delta }, function (res) {
                if(typeof loadSidebar === "function"){
                    loadSidebar(); // Gọi hàm load lại Sidebar đã viết ở file Menu/Layout
                } else {
                    location.reload(); // Fallback nếu không có Ajax load
                }
            });
        }
    </script>
}
@model IEnumerable<QuanLiQuanCaffee.Models.Table>
@{ ViewData["Title"] = "Một chỗ ngồi. Một câu chuyện."; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">BÁN HÀNG / DANH SÁCH BÀN</p><h1>Một chỗ ngồi. Một câu chuyện.</h1><p class="ux-subtitle">Chọn bàn để bắt đầu hoặc tiếp tục phục vụ.</p></div><div class="ux-head-actions"></div></header><div class="ux-metrics"><article><span>Tổng số bàn</span><strong>@Model.Count()</strong></article><article><span>Bàn trống</span><strong>@Model.Count(t=>t.Status=="Trống")</strong></article><article><span>Đang dùng</span><strong>@Model.Count(t=>t.Status=="Đang dùng")</strong></article></div><div class="ux-toolbar"><label class="ux-search"><span aria-hidden="true">⌕</span><input type="search" data-row-search="floor-tables" placeholder="Tìm tên bàn hoặc trạng thái…" aria-label="Tìm tên bàn hoặc trạng thái…"/></label><span class="ux-help" data-search-count="floor-tables" aria-live="polite"></span></div><p class="ux-filter-empty" data-search-empty="floor-tables" hidden>Không tìm thấy kết quả phù hợp.</p><div class="ux-floor-grid" id="floor-tables">@foreach(var table in Model){<a data-search-row class="ux-floor-card @(table.Status=="Trống" ? "free" : "busy")" href="/Order/Menu?tableId=@table.TableID"><span class="ux-table-symbol" aria-hidden="true">☷</span><h2>@table.Name</h2><span class="ux-badge @(table.Status=="Trống" ? "good" : "warm")">@table.Status</span><small>@(table.Status=="Trống" ? "Bắt đầu đơn mới " : "Xem đơn tại bàn ")</small></a>}</div></section>

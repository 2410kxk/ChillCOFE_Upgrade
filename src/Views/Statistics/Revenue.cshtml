@{
    ViewData["Title"] = "Thống kê doanh thu";
}

<section class="ux-page ux-report"><header class="ux-page-head"><div><p class="lx-kicker">BÁO CÁO / DOANH THU</p><h1>Những con số kể câu chuyện.</h1><p class="ux-subtitle">Theo dõi kết quả bán hàng và báo cáo thu ngân.</p></div><div class="ux-head-actions"></div></header><div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">Tổng quan doanh thu</h2>
        <div>
            <button class="btn btn-info text-white shadow-sm me-2" onclick="showRevenueDetail()">
                <i class="bi bi-file-earmark-bar-graph"></i> Xem chi tiết
            </button>
            <button class="btn btn-dark shadow-sm" onclick="window.location.reload()">
                <i class="bi bi-arrow-repeat"></i> Làm mới báo cáo
            </button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase opacity-75">Tổng đơn hàng</h6>
                    <h3 class="fw-bold">@ViewBag.TotalOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase opacity-75">Doanh thu hôm nay</h6>
                    <h3 class="fw-bold">@string.Format("{0:N0}", ViewBag.TodayRevenue) VNĐ</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase opacity-75">Tháng @DateTime.Now.Month</h6>
                    <h3 class="fw-bold">@string.Format("{0:N0}", ViewBag.MonthRevenue) VNĐ</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-header bg-white fw-bold">Doanh thu 7 ngày gần nhất</div>
        <div class="card-body">
            <canvas id="revenueChart" style="max-height: 350px;"></canvas>
        </div>
    </div>
</div>

<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold">TỔNG KẾT THU NGÂN</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light" id="reportPrintArea">
                <div class="p-4 bg-white border border-secondary shadow-sm">
                    <div class="text-center mb-3">
                        <h4 class="fw-bold text-uppercase mb-0">Chill COFÉ</h4>
                        <p class="mb-0">Ngày báo cáo: <span id="rep-date" class="fw-bold"></span></p>
                        <hr class="my-2">
                    </div>

                    <div class="table-responsive"><table class="table table-sm table-borderless">
                        <tbody id="rep-content">
                            </tbody>
                    </table></div>

                    <div class="mt-3 pt-2 border-top text-center italic small">
                        * Báo cáo được trích xuất từ hệ thống quản lý *
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" onclick="downloadReportImage()">
                    <i class="bi bi-download"></i> Tải ảnh báo cáo
                </button>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

</section>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
function uiEscape(value){const span=document.createElement('span');span.textContent=String(value ?? '');return span.innerHTML.replace(/"/g,'&quot;').replace(/'/g,'&#39;');}

        function showRevenueDetail() {
            // Đã sửa đường dẫn thành /Statistics/ để khớp với Controller của bạn
            fetch('/Statistics/GetRevenueDetail')
                .then(res => {
                    if (!res.ok) throw new Error("Lỗi kết nối server");
                    return res.json();
                })
                .then(data => {
                    document.getElementById('rep-date').innerText = data.date;
                    
                    let html = `
                        <tr><td width="10%">1</td><td>Số đơn hàng</td><td class="text-end fw-bold">${data.totalOrders}</td></tr>
                        <tr><td>2</td><td>Chiết khấu</td><td class="text-end">0</td></tr>
                        <tr><td>3</td><td>Tổng doanh thu</td><td class="text-end fw-bold">${data.totalSales.toLocaleString()}đ</td></tr>
                        <tr class="table-light border-top">
                            <td class="fw-bold">9</td><td class="fw-bold">THỰC THU</td>
                            <td class="text-end fw-bold text-danger">${data.netSales.toLocaleString()}đ</td>
                        </tr>
                        <tr class="table-secondary"><td colspan="3" class="fw-bold text-center">10. HÀNG HÓA BÁN RA</td></tr>
                    `;

                    if (data.productStats && data.productStats.length > 0) {
                        data.productStats.forEach(p => {
                            html += `<tr><td>-</td><td>${uiEscape(p.name)}</td><td class="text-end">${p.qty} món</td></tr>`;
                        });
                    } else {
                        html += `<tr><td colspan="3" class="text-center italic">Chưa có món nào bán ra</td></tr>`;
                    }

                    document.getElementById('rep-content').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('reportModal')).show();
                })
                .catch(err => {
                    console.error(err);
                    alert("Lỗi: " + err.message);
                });
        }

        function downloadReportImage() {
            const area = document.getElementById('reportPrintArea');
            html2canvas(area, { scale: 2 }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'Bao_Cao_Doanh_Thu_ChillCOFE.png';
                link.href = canvas.toDataURL("image/png");
                link.click();
            });
        }

        // Khởi tạo biểu đồ doanh thu
        const ctx = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartValues)),
                    borderColor: '#85603e',
                    backgroundColor: 'rgba(133, 96, 62, 0.12)',
                    fill: true,
                    tension: 0.3
                }]
            }
        });
    </script>
}
@model QuanLiQuanCaffee.Models.Product
@{ ViewData["Title"] = "Hương vị của bạn"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">THỰC ĐƠN / CHI TIẾT MÓN</p><h1>Hương vị của bạn</h1><p class="ux-subtitle"></p></div><div class="ux-head-actions"><a href="/Cafe/Menu" class="lx-text-link"> Trở lại thực đơn</a></div></header><div class="ux-detail"><div class="ux-detail-photo"><img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/editorial/coffee-art.png" : Model.ImageUrl)" alt="@Model.Name"/><span class="ux-photo-label">CHILL COFÉ / YOUR DAILY CUP</span></div><div class="ux-detail-copy"><p class="lx-kicker">@Model.Category?.Name</p><h2>@Model.Name</h2><p class="ux-detail-description">@Model.Description</p><div class="ux-price">@Model.Price.ToString("N0") <small>đ</small></div><span class="ux-badge @(Model.IsAvailable ? "good" : "muted")">@(Model.IsAvailable ? "Đang phục vụ" : "Tạm hết món")</span><div class="ux-detail-options"><h3>Thưởng thức theo cách của bạn</h3><p>@(Model.SupportsCustomization ? "Giá niêm yết cho size M. Size L thêm 7.000đ. Chọn mức đường, đá và topping tại quầy." : "Món được phục vụ theo khẩu phần tiêu chuẩn.")</p></div>
@if(User.IsInRole("Admin") || User.IsInRole("Staff")){<a class="lx-button" href="/Pos/Tables">Chọn bàn để gọi món </a>}else{<p>Gọi món tại quầy để chọn tùy chọn phù hợp.</p><a class="lx-button" href="/Cafe/Menu">Xem thực đơn tại quán </a>}
</div></div></section>

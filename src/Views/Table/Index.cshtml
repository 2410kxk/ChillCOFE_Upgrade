@model IEnumerable<QuanLiQuanCaffee.Models.Table>
@{
    ViewData["Title"] = "Quản lý bàn";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between">
            <h5 class="mb-0">DANH SÁCH BÀN TRONG HỆ THỐNG</h5>
            <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#addTableModal">+ Thêm bàn</button>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên bàn</th>
                        <th>Trạng thái hiện tại</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.TableID</td>
                            <td><strong>@t.Name</strong></td>
                            <td>
                                <span class="badge @(t.Status == "Trống" ? "bg-success" : "bg-danger")">@t.Status</span>
                            </td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@t.TableID" method="post" onsubmit="return confirm('Xóa bàn này?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addTableModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post">
            <div class="modal-content">
                <div class="modal-header"><h5>Thêm bàn mới</h5></div>
                <div class="modal-body">
                    <input type="text" name="name" class="form-control" placeholder="Ví dụ: Bàn A10" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-target="#addTableModal" data-bs-toggle="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu bàn</button>
                </div>
            </div>
        </form>
    </div>
</div>
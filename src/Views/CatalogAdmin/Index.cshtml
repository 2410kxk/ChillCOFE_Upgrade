@model IEnumerable<QuanLiQuanCaffee.Models.Product>
@{ ViewData["Title"] = "Thực đơn của quán"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">QUẢN TRỊ / SẢN PHẨM</p><h1>Thực đơn của quán</h1><p class="ux-subtitle">Cập nhật món và trạng thái phục vụ. Ngừng bán vẫn giữ lịch sử đơn.</p></div><div class="ux-head-actions"><a href="/Product/Create" class="lx-button">+ Thêm món</a></div></header><div class="ux-metrics"><article><span>Món trong danh sách</span><strong>@Model.Count()</strong></article><article><span>Đang phục vụ</span><strong>@Model.Count(p=>p.IsAvailable)</strong></article><article><span>Tạm hết</span><strong>@Model.Count(p=>!p.IsAvailable)</strong></article></div><div class="ux-toolbar"><label class="ux-search"><span aria-hidden="true">⌕</span><input type="search" data-row-search="catalog-table" placeholder="Tìm tên món hoặc danh mục…" aria-label="Tìm tên món hoặc danh mục…"/></label><span class="ux-help" data-search-count="catalog-table" aria-live="polite"></span></div><p class="ux-filter-empty" data-search-empty="catalog-table" hidden>Không tìm thấy kết quả phù hợp.</p><div class="ux-panel ux-table-panel"><div class="table-responsive"><table class="table" id="catalog-table"><thead><tr><th>Món</th><th>Danh mục</th><th>Giá niêm yết</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr data-search-row><td><div class="ux-cell-product"><img src="@p.ImageUrl" alt="" loading="lazy"/><div><strong>@p.Name</strong><small>#@p.ProductID</small></div></div></td><td>@p.Category?.Name</td><td class="ux-money">@p.Price.ToString("N0") đ</td><td><span class="ux-badge @(p.IsAvailable ? "good" : "muted")">@(p.IsAvailable ? "Đang bán" : "Tạm hết")</span></td><td><div class="ux-row-actions"><a href="/Product/Edit/@p.ProductID" class="btn btn-sm btn-outline-secondary">Sửa</a><form asp-action="Availability" method="post"><input type="hidden" name="id" value="@p.ProductID"/><input type="hidden" name="available" value="@(p.IsAvailable ? "false" : "true")"/><button class="btn btn-sm btn-outline-secondary">@(p.IsAvailable ? "Báo hết món" : "Mở bán lại")</button></form></div></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="ux-empty"><h2>Thực đơn đang chờ món đầu tiên.</h2><a href="/Product/Create" class="lx-button">Thêm món </a></div>}</div></section>

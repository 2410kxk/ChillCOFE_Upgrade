@model QuanLiQuanCaffee.Models.Product
<article class="ch-product ux-product" data-name="@Model.Name" data-category="@Model.CategoryID" data-price="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-available="@Model.IsAvailable.ToString().ToLowerInvariant()">
<div class="ch-product-image ux-product-visual"><a href="/Product/Details/@Model.ProductID" aria-label="Xem @Model.Name"><img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/ca-phe-kem-muoi.jpg" : Model.ImageUrl)" alt="@Model.Name" loading="lazy" decoding="async"/>
</a>
@if(!Model.IsAvailable){<span class="ch-badge sold">Tạm hết</span>}</div>
<div class="ch-product-info"><span class="ch-category">@Model.Category?.Name</span><h3><a href="/Product/Details/@Model.ProductID">@Model.Name</a></h3><div class="ch-product-bottom"><strong>@Model.Price.ToString("N0") <small>đ</small></strong>
@if(ViewData["Pos"] is true){<button class="ch-add" type="button" data-pick="@Model.ProductID" disabled="@(!Model.IsAvailable)" aria-label="Chọn @Model.Name">+</button>}
else if(User.Identity?.IsAuthenticated==true && !User.IsInRole("Admin") && !User.IsInRole("Staff")){<button type="button" class="ch-add" data-online-add="@Model.ProductID" disabled="@(!Model.IsAvailable)" aria-label="Thêm @Model.Name vào giỏ hàng">🛒</button>}
else{<a class="ch-add" href="/Product/Details/@Model.ProductID" aria-label="Xem @Model.Name">Xem</a>}
</div></div></article>
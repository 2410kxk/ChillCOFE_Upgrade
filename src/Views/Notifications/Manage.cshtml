@model List<QuanLiQuanCaffee.Models.CafeNotification>
@{ViewData["Title"]="Quản lý thông báo";}
<section class="ux-page"><header class="page-heading"><p class="eyebrow">KẾT NỐI VỚI KHÁCH HÀNG & ĐỘI NGŨ</p><h1>Quản lý thông báo</h1><p>Thông báo xuất hiện trong website với nhóm tài khoản được chọn.</p></header><form asp-action="Create" method="post" class="surface form-stack"><label>Tiêu đề<input name="title" maxlength="120" required/></label><label>Gửi đến<select name="audience"><option value="All">Khách hàng và nhân viên</option><option value="User">Khách hàng</option><option value="Staff">Nhân viên</option></select></label><label>Nội dung<textarea name="content" maxlength="4000" rows="4" required></textarea></label><button class="lx-button">Đăng thông báo</button></form><h2>Thông báo đã đăng</h2>@foreach(var n in Model){<article class="surface notification-card"><span class="role-label">@(n.Audience=="All"?"Tất cả":n.Audience=="Staff"?"Nhân viên":"Khách hàng")</span><time>@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time><h3>@n.Title</h3><p class="preserve-lines">@n.Content</p><form asp-action="Delete" method="post" data-confirm="Gỡ thông báo này khỏi website?"><input type="hidden" name="id" value="@n.Id"/><button class="text-danger">Gỡ thông báo</button></form></article>}<nav class="pagination">@if(ViewBag.Page>1){<a asp-route-page="@(ViewBag.Page-1)">Trang trước</a>}<span>@ViewBag.Page / @ViewBag.Pages</span>@if(ViewBag.Page<ViewBag.Pages){<a asp-route-page="@(ViewBag.Page+1)">Trang sau</a>}</nav></section>

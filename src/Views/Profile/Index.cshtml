@model QuanLiQuanCaffee.ViewModels.ProfileInput
@{ViewData["Title"]="Tài khoản của tôi";}
<section class="community-page narrow"><header class="page-heading"><p class="eyebrow">MỘT CHÚT VỀ BẠN</p><h1>Tài khoản của tôi</h1><p>Cập nhật thông tin để mỗi lần ghé quán thêm thân quen.</p></header><form asp-action="Index" method="post" enctype="multipart/form-data" class="surface form-stack"><div asp-validation-summary="All" role="alert"></div>@if(!string.IsNullOrEmpty(Model.AvatarUrl)){<img class="profile-avatar" src="@Model.AvatarUrl" alt="Ảnh đại diện"/>}<label>Tên hiển thị<input asp-for="DisplayName" maxlength="80" required autocomplete="name"/></label><label>Email đăng nhập<input value="@Model.Email" readonly/></label><label>Số điện thoại<input asp-for="Phone" type="tel" maxlength="30" autocomplete="tel"/></label><label>Ảnh đại diện<input asp-for="Avatar" type="file" accept="image/jpeg,image/png,image/webp"/></label><small>JPG, PNG hoặc WebP, tối đa 5 MB. Tên hiển thị không thay đổi email đăng nhập.</small><button class="lx-button">Lưu thông tin</button><a href="/Profile/Password">Đổi mật khẩu</a><a href="/Notifications">Thông báo của tôi</a></form></section>

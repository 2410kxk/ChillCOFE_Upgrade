@model QuanLiQuanCaffee.Models.Employee
@{ ViewData["Title"] = "Chào đón thành viên mới"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">ĐỘI NGŨ / NHÂN VIÊN</p><h1>Chào đón thành viên mới</h1><p class="ux-subtitle"></p></div><div class="ux-head-actions"></div></header><div class="ux-form-layout"><form asp-action="Create" method="post" class="ux-panel"><div asp-validation-summary="All" class="text-danger" role="alert"></div><h2>Thông tin nhân viên</h2><div class="ch-field"><label asp-for="FullName">Họ và tên</label><input asp-for="FullName" required autocomplete="name"/><span asp-validation-for="FullName" class="text-danger"></span></div><div class="ch-field"><label asp-for="Position">Vị trí làm việc</label><select asp-for="Position"><option value="Pha chế">Pha chế</option><option value="Phục vụ">Phục vụ</option><option value="Quản lý">Quản lý</option></select></div><div class="ch-field-row"><div class="ch-field"><label asp-for="Phone">Số điện thoại</label><input asp-for="Phone" type="tel" autocomplete="tel"/></div><div class="ch-field"><label asp-for="HourlyRate">Lương mỗi giờ (đ)</label><input asp-for="HourlyRate" type="number" min="0"/><span asp-validation-for="HourlyRate" class="text-danger"></span></div></div><div class="ux-form-actions"><button type="submit" class="lx-button">Lưu hồ sơ </button><a asp-action="Index" class="lx-text-link">Về danh sách</a></div></form><aside class="ux-panel ux-note-panel"><p class="lx-kicker">PEOPLE OF CHILL</p><h2>Một đội ngũ.<br>Nhiều điều tốt đẹp.</h2><p>Kiểm tra họ tên, thông tin liên hệ và mức lương trước khi lưu.</p><hr/><p>Phân ca cho nhân viên tại mục Lịch làm việc sau khi hoàn tất hồ sơ.</p><a href="/Shift" class="lx-text-link">Xem lịch làm việc </a></aside></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
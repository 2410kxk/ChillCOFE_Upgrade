@model QuanLiQuanCaffee.ViewModels.PasswordInput
@{ViewData["Title"]="Đổi mật khẩu";}
<section class="community-page narrow"><h1>Đổi mật khẩu</h1><form asp-action="Password" method="post" class="surface form-stack"><div asp-validation-summary="All" role="alert"></div><label>Mật khẩu hiện tại<input asp-for="CurrentPassword" autocomplete="current-password" required/></label><label>Mật khẩu mới<input asp-for="NewPassword" autocomplete="new-password" minlength="6" required/></label><label>Nhập lại mật khẩu mới<input asp-for="ConfirmPassword" autocomplete="new-password" required/></label><button class="lx-button">Cập nhật mật khẩu</button><a href="/Profile">Quay lại tài khoản</a></form></section>

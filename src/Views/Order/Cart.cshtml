@model List<QuanLiQuanCaffee.Models.OrderDetail>
@{ ViewData["Title"] = "Giỏ món tại quầy"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">BÁN HÀNG / GIỎ MÓN</p><h1>Giỏ món tại quầy</h1><p class="ux-subtitle"></p></div><div class="ux-head-actions"></div></header><div class="ux-panel">@if (Model == null || Model.Count == 0)
{
    <div class="ux-empty"><h2>Chưa có món trong giỏ.</h2><a class="lx-button" href="/Product">Chọn món </a></div>
}
else
{
    <div class="table-responsive"><table class="table table-bordered text-center">
        <thead class="table-dark">
            <tr>
                <th>Tên món</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @{
                double total = 0;
            }

            @foreach (var item in Model)
            {
                var thanhTien = item.Price * item.Quantity;
                total += thanhTien;

                <tr>
                    <td>@item.Product?.Name</td>

                    <td>@item.Price.ToString("N0") đ</td>

                    <!-- 🔥 TĂNG GIẢM -->
                    <td>
                        <button class="btn btn-sm btn-danger btn-minus"
                                data-id="@item.DetailID">
                            -
                        </button>

                        <span class="mx-2">@item.Quantity</span>

                        <button class="btn btn-sm btn-success btn-plus"
                                data-id="@item.DetailID">
                            +
                        </button>
                    </td>

                    <td>@thanhTien.ToString("N0") đ</td>

                    <!-- ❌ XÓA -->
                    <td>
                        <button class="btn btn-sm btn-warning btn-remove"
                                data-id="@item.DetailID">
                            Xóa
                        </button>
                    </td>
                </tr>
            }

            <!-- 🔥 TỔNG TIỀN -->
            <tr>
                <td colspan="3"><b>Tổng tiền</b></td>
                <td colspan="2" class="text-danger">
                    <b>@total.ToString("N0") đ</b>
                </td>
            </tr>
        </tbody>
    </table></div>

    <div class="text-end">
        <a href="/Order/Tables" class="lx-button">Chọn bàn để tiếp tục thanh toán </a>
    </div>
}

</div></section>
@section Scripts {
    <script>
         $(".btn-add").click(function () {

            var id = $(this).data("id");

            $.post("/Order/AddToCart", { id: id }, function () {

                var count = $("#cart-count").text();
                count = parseInt(count) + 1;

                $("#cart-count").text(count);
            });
        });
                $.get("/Order/GetCartCount", function (res) {
            $("#cart-count").text(res);
        });
        // ➕ TĂNG
        $(".btn-plus").click(function () {
            var id = $(this).data("id");

            $.post("/Order/Increase", { detailId: id }, function () {
                location.reload();
            });
        });

        // ➖ GIẢM
        $(".btn-minus").click(function () {
            var id = $(this).data("id");

            $.post("/Order/Decrease", { detailId: id }, function () {
                location.reload();
            });
        });

        // ❌ XÓA
        $(".btn-remove").click(function () {
            var id = $(this).data("id");

            $.post("/Order/Remove", { detailId: id }, function () {
                location.reload();
            });
        });

    </script>
}
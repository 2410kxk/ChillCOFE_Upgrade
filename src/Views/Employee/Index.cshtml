@model IEnumerable<QuanLiQuanCaffee.Models.Employee>
@{ ViewData["Title"] = "Những người làm nên Chill."; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">ĐỘI NGŨ / NHÂN VIÊN</p><h1>Những người làm nên Chill.</h1><p class="ux-subtitle">Quản lý hồ sơ và thông tin liên hệ của đội ngũ.</p></div><div class="ux-head-actions"><a href="/Employee/Create" class="lx-button">+ Thêm nhân viên</a></div></header><div class="ux-toolbar"><label class="ux-search"><span aria-hidden="true">⌕</span><input type="search" data-row-search="employees-table" placeholder="Tìm họ tên, vị trí hoặc số điện thoại…" aria-label="Tìm họ tên, vị trí hoặc số điện thoại…"/></label><span class="ux-help" data-search-count="employees-table" aria-live="polite"></span></div><p class="ux-filter-empty" data-search-empty="employees-table" hidden>Không tìm thấy kết quả phù hợp.</p><div class="ux-panel ux-table-panel"><div class="table-responsive"><table class="table" id="employees-table">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Họ và Tên</th>
                        <th>Số điện thoại</th>
                        <th>Chức vụ</th>
                        <th>Email</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr data-search-row>
                                <td class="fw-bold ps-3">@item.FullName</td>
                                <td>@item.Phone</td>
                                <td>
                                    @if (item.Position == "Pha chế")
                                    {
                                        <span class="badge bg-info text-dark">Pha chế</span>
                                    }
                                    else if (item.Position == "Phục vụ")
                                    {
                                        <span class="badge bg-warning text-dark">Phục vụ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Position</span>
                                    }
                                </td>
                                <td>@item.Email</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.EmployeeID" class="btn btn-sm btn-outline-warning" title="Sửa">
                                            Sửa
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.EmployeeID" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            Hồ sơ
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.EmployeeID" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <em>Chưa có dữ liệu nhân viên nào trong hệ thống.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div></div></section>

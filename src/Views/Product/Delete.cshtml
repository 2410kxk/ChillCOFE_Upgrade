@model QuanLiQuanCaffee.Models.Product
@{ ViewData["Title"] = "Xác nhận xóa món"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">QUẢN TRỊ / THỰC ĐƠN</p><h1>Xác nhận xóa món</h1><p class="ux-subtitle"></p></div><div class="ux-head-actions"></div></header><div class="ux-confirm"><div class="ux-confirm-icon">!</div><h2>Xóa “@Model.Name”?</h2><p>Kiểm tra đúng món trước khi xác nhận thao tác.</p><div class="ux-confirm-product"><img src="@Model.ImageUrl" alt="@Model.Name"/><div><strong>@Model.Name</strong><p>@Model.Price.ToString("N0") đ</p></div></div><form asp-action="Delete" method="post"><input type="hidden" asp-for="ProductID"/><div class="ux-form-actions"><button type="submit" class="btn btn-danger">Xác nhận xóa</button><a asp-action="Index" class="btn btn-outline-secondary">Giữ lại món</a></div></form></div></section>

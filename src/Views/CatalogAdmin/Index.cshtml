@model IEnumerable<QuanLiQuanCaffee.Models.Product>
@{ViewData["Title"]="Quản lý thực đơn";}
<section class="ch-section"><div class="ch-section-head"><div><div class="ch-eyebrow">CHILL COFÉ / QUẢN TRỊ</div><h1>Thực đơn của quán</h1><p>Tạm hết món sẽ ngừng nhận món mới, giữ nguyên lịch sử đơn hàng.</p></div><a class="ch-button" href="/Product/Create">+ Thêm món</a></div><div class="table-responsive"><table class="table ch-admin-table"><thead><tr><th>Món</th><th>Danh mục</th><th>Giá</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><img src="@p.ImageUrl" alt=""/>@p.Name</td><td>@p.Category?.Name</td><td>@p.Price.ToString("N0") đ</td><td><span class="ch-pill">@(p.IsAvailable ? "Đang bán" : "Tạm hết")</span></td><td><div class="ch-actions"><a href="/Product/Edit/@p.ProductID">Sửa</a><form asp-action="Availability" method="post"><input type="hidden" name="id" value="@p.ProductID"/><input type="hidden" name="available" value="@(!p.IsAvailable)"/><button class="ch-button small secondary">@(p.IsAvailable ? "Báo hết món" : "Mở bán lại")</button></form></div></td></tr>}</tbody></table></div></section>

@model QuanLiQuanCaffee.ViewModels.ReviewInput
@{ViewData["Title"]="Chỉnh sửa đánh giá";}
<section class="community-page narrow"><h1>Chỉnh sửa đánh giá</h1><form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post" enctype="multipart/form-data" class="surface form-stack"><div asp-validation-summary="All"></div><label>Số sao<select asp-for="Rating">@for(var n=1;n<=5;n++){<option value="@n">@n sao</option>}</select></label><label>Nội dung<textarea asp-for="Content" maxlength="2000" rows="6" required></textarea></label><label>Thay ảnh (không chọn để giữ ảnh cũ)<input asp-for="Image" type="file" accept="image/jpeg,image/png,image/webp"/></label><button class="lx-button">Lưu đánh giá</button><a href="/Reviews">Quay lại</a></form></section>

@model QuanLiQuanCaffee.ViewModels.NotificationsVm
@{ViewData["Title"]="Thông báo của bạn";}
<section class="community-page narrow"><header class="page-heading"><p class="eyebrow">TIN MỚI TỪ CHILL COFÉ</p><h1>Thông báo của bạn</h1></header>@if(!Model.Items.Any()){<div class="empty-state">Bạn chưa có thông báo nào.</div>}@foreach(var n in Model.Items){var read=Model.ReadIds.Contains(n.Id);<article class="surface notification-card @(read?"is-read":"is-unread")"><div class="person-row"><span class="role-label">@(read?"Đã đọc":"Mới")</span><time>@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time></div><h2>@n.Title</h2><p class="preserve-lines">@n.Content</p>@if(!read){<form asp-action="Read" method="post"><input type="hidden" name="id" value="@n.Id"/><button>Đánh dấu đã đọc</button></form>}</article>}<nav class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)">Trang trước</a>}<span>@Model.Page / @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)">Trang sau</a>}</nav></section>

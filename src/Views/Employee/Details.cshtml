@model QuanLiQuanCaffee.Models.Employee
@{ ViewData["Title"] = "Hồ sơ nhân viên"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">ĐỘI NGŨ / HỒ SƠ</p><h1>Hồ sơ nhân viên</h1><p class="ux-subtitle"></p></div><div class="ux-head-actions"></div></header><div class="ux-profile"><div class="ux-profile-cover"><span class="ux-avatar">NV</span><h2>@Model.FullName</h2><span class="ux-badge">@Model.Position</span></div><div class="ux-panel"><h2>Thông tin liên hệ</h2><dl class="ux-definition"><dt>Số điện thoại</dt><dd>@Model.Phone</dd><dt>Email</dt><dd>@Model.Email</dd><dt>Lương mỗi giờ</dt><dd>@string.Format("{0:N0}", Model.HourlyRate) đ</dd></dl><div class="ux-form-actions"><a asp-action="Edit" asp-route-id="@Model.EmployeeID" class="lx-button">Chỉnh sửa hồ sơ </a><a asp-action="Index" class="lx-text-link">Về danh sách</a></div></div></div></section>

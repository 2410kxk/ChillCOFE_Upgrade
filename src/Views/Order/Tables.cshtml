@model IEnumerable<QuanLiQuanCaffee.Models.Table>

@{
    var areas = new[] { "A", "B", "C", "D" };
}

<div class="container-fluid py-4 bg-light-gray min-vh-100">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold text-dark m-0">Sơ đồ phòng bàn</h2>
                <span class="text-muted small">Cập nhật lúc: @DateTime.Now.ToString("HH:mm")</span>
            </div>

            <div class="filter-wrapper d-flex gap-2">
                <label class="filter-chip">
                    <input type="radio" name="statusFilter" value="all" checked onclick="filterByStatus('all')">
                    <span class="chip-content">
                        <i class="bi bi-grid-fill"></i> Tất cả
                        <small class="ms-1">(@Model.Count())</small>
                    </span>
                </label>
                <label class="filter-chip chip-busy">
                    <input type="radio" name="statusFilter" value="Đang dùng" onclick="filterByStatus('Đang dùng')">
                    <span class="chip-content">
                        <i class="bi bi-person-fill"></i> Đang dùng
                        <small class="ms-1">(@Model.Count(t => t.Status == "Đang dùng"))</small>
                    </span>
                </label>
                <label class="filter-chip chip-free">
                    <input type="radio" name="statusFilter" value="Trống" onclick="filterByStatus('Trống')">
                    <span class="chip-content">
                        <i class="bi bi-check-circle-fill"></i> Đang trống
                        <small class="ms-1">(@Model.Count(t => t.Status == "Trống"))</small>
                    </span>
                </label>
            </div>
        </div>

        <div class="area-navigation shadow-sm mb-4 p-2 bg-white rounded-pill">
            <ul class="nav nav-pills nav-justified" id="pills-tab" role="tablist">
                @foreach (var area in areas)
                {
                    <li class="nav-item">
                        <button class="nav-link rounded-pill fw-bold py-2 @(area == "A" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#area-@area">
                            KHU @area
                        </button>
                    </li>
                }
            </ul>
        </div>

        <div class="tab-content">
            @foreach (var area in areas)
            {
                <div class="tab-pane fade @(area == "A" ? "show active" : "")" id="area-@area">
                    <div class="row g-4 mt-1">
                        @foreach (var t in Model.Where(t => t.Name.StartsWith(area)))
                        {
                            <div class="col-6 col-md-4 col-lg-2-4 table-box" data-status="@t.Status">
                                <a href="/Order/Menu?tableId=@t.TableID" class="text-decoration-none">
                                    <div class="card border-0 shadow-sm table-card-premium @(t.Status == "Đang dùng" ? "is-busy" : "is-free")">
                                        <div class="card-body py-4">
                                            <div class="table-name">@t.Name</div>
                                            <div class="table-indicator"></div>
                                            <div class="table-status mt-2">@t.Status</div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Tổng thể */
    .bg-light-gray {
        background-color: #f8f9fa;
    }

    .col-lg-2-4 {
        flex: 0 0 auto;
        width: 20%;
    }
    /* Chia 5 bàn 1 hàng cho PC */

    /* Filter Chips - PHẦN BẠN YÊU CẦU */
    .filter-chip {
        cursor: pointer;
    }

        .filter-chip input {
            display: none;
        }

    .chip-content {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 50px;
        background: white;
        border: 2px solid #eee;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    /* Effect when checked */
    .filter-chip input:checked + .chip-content {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        border-color: #b22830;
        color: #b22830;
    }

    .chip-busy input:checked + .chip-content {
        border-color: #0d6efd;
        color: #0d6efd;
    }

    .chip-free input:checked + .chip-content {
        border-color: #198754;
        color: #198754;
    }

    /* Area Navigation */
    .nav-pills .nav-link {
        color: #555;
        background: transparent;
    }

        .nav-pills .nav-link.active {
            background-color: #b22830 !important;
            color: white !important;
        }

    /* Card Bàn - Phong cách Premium */
    .table-card-premium {
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        position: relative;
        overflow: hidden;
    }

        .table-card-premium:hover {
            transform: translateY(-8px);
        }

    .table-name {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .table-status {
        font-size: 0.75rem;
        font-weight: 600;
        opacity: 0.8;
    }

    .table-indicator {
        width: 40px;
        height: 4px;
        border-radius: 10px;
        margin: 10px auto;
    }

    /* Trạng thái bàn */
    .is-free {
        background: white;
        border: 1px solid #f0f0f0 !important;
    }

        .is-free .table-indicator {
            background-color: #198754;
        }

        .is-free .table-name {
            color: #333;
        }

    .is-busy {
        background: #0d6efd;
        color: white;
    }

        .is-busy .table-indicator {
            background-color: rgba(255,255,255,0.8);
        }

        .is-busy .table-name {
            color: white;
        }

    @@media (max-width: 992px) {
        .col-lg-2-4 {
            width: 33.33%;
        }
    }
</style>

<script>
    function filterByStatus(status) {
        const boxes = document.querySelectorAll('.table-box');
        boxes.forEach(box => {
            if (status === 'all' || box.getAttribute('data-status') === status) {
                box.style.display = 'block';
            } else {
                box.style.display = 'none';
            }
        });
    }
</script>
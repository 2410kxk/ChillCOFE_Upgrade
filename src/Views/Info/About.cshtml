@{
    ViewData["Title"] = "Về Chill COFÉ";
}

<div class="container my-5">
    <section class="premium-about-section mb-5 position-relative text-white source-bg">
        <div class="row h-100 align-items-center">
            <div class="col-lg-7 col-md-9 ps-lg-5 position-relative z-2">
                <div class="glass-content-box p-5 rounded">
                    <h6 class="text-warning fw-bold mb-2 text-uppercase">CÂU CHUYỆN CỦA CHÚNG MÌNH</h6>
                    <h1 class="fw-800 display-4 mb-4 title-gold">NGUỒN GỐC</h1>

                    <p class="lh-lg text-white-80">
                        Chill COFÉ không đơn thuần là một quán cà phê — đó là nơi những câu chuyện bắt đầu,
                        nơi cảm xúc được chia sẻ và những khoảnh khắc đời thường trở nên đáng nhớ hơn.
                        Chúng mình ra đời với mong muốn kết nối cộng đồng yêu cà phê tại Việt Nam.
                    </p>
                    <p class="lh-lg text-white-80">
                        Giữa nhịp sống hối hả, Chill COFÉ mang đến một không gian hiện đại nhưng ấm cúng,
                        nơi bạn có thể tạm dừng lại và tận hưởng sự bình yên với một ly cà phê đậm vị.
                    </p>
                    <a href="/Product/Menu" class="btn btn-red-gold px-5 py-3 rounded-pill mt-4 text-uppercase fw-bold">XEM THỰC ĐƠN</a>
                </div>
            </div>
        </div>
    </section>

    <section class="premium-about-section service-bg">
        <div class="row h-100 align-items-center">
            <div class="col-lg-7 col-md-9 offset-lg-5 pe-lg-5">
                <div class="glass-content-box p-5 rounded">
                    <h6 class="text-warning fw-bold mb-2 text-uppercase">TẬN TÂM PHỤC VỤ</h6>
                    <h2 class="fw-800 display-4 mb-4 title-gold">DỊCH VỤ</h2>
                    <p class="lh-lg text-white-80 ps-lg-4">
                        Với triết lý <b>“Chất lượng – Thân thiện – Trải nghiệm”</b>, chúng tôi không chỉ phục vụ đồ uống
                        mà còn tạo nên một điểm đến để bạn muốn quay lại. Đội ngũ barista của Chill COFÉ luôn
                        nỗ lực hết mình để mang đến cho bạn sự hài lòng tuyệt đối.
                    </p>

                    <div class="row mt-5 text-center ps-lg-4">
                        <div class="col-6 mb-3 border-end">
                            <h4 class="text-gold fw-bold mb-1">100%</h4>
                            <small class="text-white text-uppercase small">Cà phê nguyên chất</small>
                        </div>
                        <div class="col-6 mb-3">
                            <h4 class="text-gold fw-bold mb-1">FREE</h4>
                            <small class="text-white text-uppercase small">Wifi tốc độ cao</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
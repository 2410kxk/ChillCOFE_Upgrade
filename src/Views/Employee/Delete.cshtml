@model QuanLiQuanCaffee.Models.Employee
@{ ViewData["Title"] = "Xác nhận xóa nhân viên"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">ĐỘI NGŨ / HỒ SƠ</p><h1>Xác nhận xóa nhân viên</h1><p class="ux-subtitle"></p></div><div class="ux-head-actions"></div></header><div class="ux-confirm"><div class="ux-confirm-icon">!</div><h2>Xóa hồ sơ nhân viên?</h2><p>Hãy kiểm tra thông tin trước khi tiếp tục.</p><dl class="ux-definition"><dt>Họ tên</dt><dd>@Model.FullName</dd><dt>Vị trí</dt><dd>@Model.Position</dd><dt>Điện thoại</dt><dd>@Model.Phone</dd><dt>Email</dt><dd>@Model.Email</dd></dl><form asp-action="Delete" method="post"><input type="hidden" asp-for="EmployeeID" name="id"/><div class="ux-form-actions"><button type="submit" class="btn btn-danger">Xác nhận xóa</button><a asp-action="Index" class="btn btn-outline-secondary">Giữ lại hồ sơ</a></div></form></div></section>

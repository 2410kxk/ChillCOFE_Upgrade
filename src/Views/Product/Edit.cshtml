@model QuanLiQuanCaffee.Models.Product
@{ ViewData["Title"] = "Chỉnh sửa món"; }
<section class="ux-page"><header class="ux-page-head"><div><p class="lx-kicker">QUẢN TRỊ / THỰC ĐƠN</p><h1>Chỉnh sửa món</h1><p class="ux-subtitle"></p></div><div class="ux-head-actions"><a href="/CatalogAdmin" class="lx-text-link"> Quản lý thực đơn</a></div></header><form asp-action="Edit" method="post" enctype="multipart/form-data" class="ux-form-layout"><div class="ux-panel"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input type="hidden" asp-for="ProductID"/><h2>Thông tin món</h2><p class="ux-help">Tên rõ ràng và mô tả ngắn giúp khách chọn món dễ hơn.</p><div class="ch-field"><label asp-for="Name">Tên món</label><input asp-for="Name" maxlength="120" required placeholder="Ví dụ: Cà phê kem muối"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="ch-field-row"><div class="ch-field"><label asp-for="Price">Giá size M (đ)</label><input asp-for="Price" type="number" min="0" max="10000000" required/><span asp-validation-for="Price" class="text-danger"></span></div><div class="ch-field"><label asp-for="CategoryID">Danh mục</label><select asp-for="CategoryID" asp-items="ViewBag.CategoryID"></select></div></div><div class="ch-field"><label asp-for="Description">Mô tả hương vị</label><textarea asp-for="Description" rows="5" maxlength="1000" placeholder="Hương thơm, độ ngọt và điểm đặc biệt của món…"></textarea></div><label class="ux-toggle-row"><input asp-for="SupportsCustomization"/><span><strong>Cho phép tùy chỉnh</strong><small>Size, đường, đá và topping.</small></span></label><div class="ux-form-actions"><button class="lx-button" type="submit">Lưu món </button><a href="/CatalogAdmin" class="lx-text-link">Hủy thay đổi</a></div></div><aside class="ux-panel ux-upload-panel"><p class="lx-kicker">HÌNH ẢNH SẢN PHẨM</p><img class="ux-form-preview" data-upload-preview src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/editorial/coffee-art.png" : Model.ImageUrl)" alt="Ảnh hiện tại của món"/><div class="ch-field"><label for="imageFile">Chọn ảnh món</label><input type="file" name="imageFile" id="imageFile" accept=".jpg,.jpeg,.png,.webp,.avif" data-image-upload/><small class="ux-help">Tối đa 5 MB. JPG, PNG, WebP hoặc AVIF. Ảnh xem trước chưa được lưu cho đến khi bạn nhấn Lưu món.</small><p data-upload-error role="alert" class="text-danger"></p></div></aside></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
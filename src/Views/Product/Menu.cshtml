    @model IEnumerable<QuanLiQuanCaffee.Models.Product>

    @{
        var categories = ViewBag.Categories as List<QuanLiQuanCaffee.Models.Category>;
    }

    <div class="container-fluid mt-4">
        <div class="row">

            <!-- LEFT: CATEGORY -->
            <div class="col-md-3 category-sidebar">
                <h4 class="mb-3">THỰC ĐƠN</h4>

                @foreach (var c in categories)
                {
                    <a href="/Product/Menu?categoryId=@c.CategoryID"
                       class="category-item">
                        @c.Name
                    </a>
                }
            </div>

            <!-- RIGHT: PRODUCTS -->
            <div class="col-md-9">

                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4">
                            <div class="product-card">

                                <img src="@item.ImageUrl" class="product-img" />

                                <div class="card-body text-center">
                                    <h5 class="card-title">@item.Name</h5>
                                    <p class="text-danger">@item.Price.ToString("N0") VNĐ</p>

                                <button class="btn btn-dark rounded-pill w-100" onclick="addToOnlineCart(@item.ProductID)">
                                        + Thêm món
                                    </button>
                                </div>

                            </div>
                        </div>
                    }
                </div>

            </div>

        </div>
    </div>

@section Scripts {
    <script>
        function addToOnlineCart(productId) {
            $.post('/Order/AddToOnlineCart', { id: productId }, function (res) {

                console.log(res);

                if (res.count !== undefined) {

                    $("#online-cart-count").text(res.count);

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Đã thêm vào giỏ hàng!',
                        showConfirmButton: false,
                        timer: 1500
                    });

                } else {
                    alert("Không thêm được món!");
                }

            }).fail(function () {
                alert("Lỗi server!");
            });
        }
    </script>
}
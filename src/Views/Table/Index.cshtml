@model IEnumerable<QuanLiQuanCaffee.Models.Table>
@{ViewData["Title"]="Quản lý bàn";}
<section class="ux-page"><header class="page-heading"><h1>Bàn & không gian</h1><p>Ghi chú vị trí, số chỗ hoặc đặc điểm để nhân viên sắp xếp khách phù hợp.</p></header><form asp-action="Create" method="post" class="surface form-stack"><label>Tên bàn<input name="name" required maxlength="80" placeholder="Ví dụ: A01"/></label><label>Ghi chú<input name="note" maxlength="300" placeholder="Ví dụ: 4 chỗ · gần cửa sổ · có ổ cắm"/></label><button class="lx-button">Thêm bàn</button></form><div class="ux-floor-grid">@foreach(var t in Model){<article class="surface"><h2>@t.Name</h2><span class="ux-badge">@t.Status</span><form asp-action="UpdateNote" method="post" class="form-stack"><input type="hidden" name="id" value="@t.TableID"/><label>Ghi chú<textarea name="note" maxlength="300" rows="3">@t.Note</textarea></label><button>Lưu ghi chú</button></form><form asp-action="Delete" method="post" data-confirm="Xóa bàn chưa có lịch sử đơn hàng?"><input type="hidden" name="id" value="@t.TableID"/><button class="quiet-button text-danger">Xóa bàn</button></form></article>}</div></section>